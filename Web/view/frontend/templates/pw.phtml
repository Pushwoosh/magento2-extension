<?php

use Pushwoosh\Web\Block\PushwooshWeb;

/**
 * @var PushwooshWeb $block
 */
$helper = $block->getHelper();
if (!$helper->isEnabled()){
    return;
}
$safariWebsitePushId = $helper->getSafariWebsitePushId();
?>

<script type="text/javascript" src="https://cdn.pushwoosh.com/webpush/v3/pushwoosh-web-notifications.js" async></script>
<script type="text/javascript">
    var Pushwoosh = Pushwoosh || [];
    var pushwooshConfig = {
        logLevel: 'info',
        applicationCode: "<?= $block->escapeJs((string)$helper->getApplicationCode()) ?>",
<?php if ($helper->getApiToken() !== ''): ?>
        apiToken: "<?= $block->escapeHtml($helper->getApiToken()) ?>",
<?php endif; ?>
<?php if ($safariWebsitePushId !== ''): ?>
        safariWebsitePushID: "<?= $block->escapeJs($safariWebsitePushId) ?>",
<?php endif; ?>
        defaultNotificationTitle: "<?= $block->escapeJs($helper->getDefaultNotificationTitle()) ?>",
        defaultNotificationImage: "<?= $block->escapeJs($helper->getDefaultNotificationImage()) ?>",
        scope: '/',
        serviceWorkerUrl: '/pushwoosh_web/serviceworker/index',
    }

    Pushwoosh.push(['init', pushwooshConfig]);
</script>
<script type="text/javascript">
    require([
        'jquery',
        'mage/url'
    ], function ($, urlBuilder) {
        'use strict';

        $.ajax({
            url: urlBuilder.build('pushwoosh_web/customeremail/index'),
            type: 'GET',
            dataType: 'json'
        }).done(function (data) {
            if (data.email) {
                Pushwoosh.push(['onReady', function(api){
                    api.registerUser(data.email);
                }]);
            }
        });
    });
</script>
